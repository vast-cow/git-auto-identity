#!/usr/bin/env bash
set -euo pipefail

fail() {
    printf '[post-checkout] ERROR: %s\n' "$*" >&2
    exit 1
}

# Skip file checkouts.
[[ ${3:-0} == 1 ]] || exit 0

# Skip repositories where both identity settings are already set locally.
if [[ -n $(git config --local --get user.name) &&
      -n $(git config --local --get user.email) ]]; then
    exit 0
fi

# Get the URL for origin.
remote=$(git remote get-url origin 2>/dev/null) || exit 0

# Parse the GitHub remote URL.
case "$remote" in
    git@github.com:*)
        path=${remote#git@github.com:}
        ;;
    https://github.com/*)
        path=${remote#https://github.com/}
        ;;
    ssh://git@github.com/*)
        path=${remote#ssh://git@github.com/}
        ;;
    ssh://git@github.com:22/*)
        path=${remote#ssh://git@github.com:22/}
        ;;
    ssh://git@ssh.github.com:443/*)
        path=${remote#ssh://git@ssh.github.com:443/}
        ;;
    *)
        exit 0
        ;;
esac

# Extract the owner and normalize it to lowercase.
[[ $path =~ ^([^/]+)/[^/]+/?$ ]] || exit 0
owner=$(printf '%s' "${BASH_REMATCH[1]}" |
    LC_ALL=C tr 'A-Z' 'a-z')

# Initialize the mapping variables.
username=''
name=''
email=''

# Load the mapping from the hook's directory.
hook_dir=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P) ||
    fail "Failed to resolve hook directory"
mapping_file="$hook_dir/github-owners.sh"

[[ -f $mapping_file && -r $mapping_file ]] ||
    fail "Mapping file not found or unreadable: $mapping_file"

# shellcheck source=github-owners.sh
source "$mapping_file" || fail "Failed to load mapping: $mapping_file"

declare -F map_github_owner >/dev/null ||
    fail "map_github_owner is not defined: $mapping_file"

# Skip owners without a mapping.
map_github_owner "$owner" || exit 0

# Choose the configuration mode based on whether username is set.
if [[ -n $username ]]; then
    mode=github-api

    # Reject mappings that mix API and direct settings.
    [[ -z $name && -z $email ]] ||
        fail "Specify either username or name and email: $owner"

    # Validate the GitHub username.
    case "$username" in
        -*|*-|*[!A-Za-z0-9-]*|*--*)
            fail "Invalid GitHub username: $username"
            ;;
    esac
    [[ ${#username} -le 39 ]] ||
        fail "Invalid GitHub username: $username"

    # Check for the commands required in API mode.
    for cmd in curl jq; do
        command -v "$cmd" >/dev/null 2>&1 ||
            fail "Required command not found: $cmd"
    done

    # Fetch the user profile from the GitHub REST API.
    if ! response=$(curl \
        --fail \
        --silent \
        --show-error \
        --location \
        --connect-timeout 5 \
        --max-time 15 \
        --header 'Accept: application/vnd.github+json' \
        "https://api.github.com/users/${username}"); then
        fail "Failed to fetch GitHub user: $username"
    fi

    # Fall back to the login when the profile name is unset.
    if ! name=$(jq -er '
        select(.type == "User")
        | if (.name | type == "string" and length > 0)
          then .name else .login end
        | select(type == "string" and length > 0)
    ' <<< "$response"); then
        fail "Invalid GitHub user profile: $username"
    fi

    # Generate the GitHub noreply email address.
    if ! email=$(jq -er '
        select(.id | type == "number" and . > 0 and . == floor)
        | select(.login | type == "string" and test("^[A-Za-z0-9-]+$"))
        | "\(.id)+\(.login)@users.noreply.github.com"
    ' <<< "$response"); then
        fail "Invalid GitHub user profile: $username"
    fi
else
    mode=direct
fi

# Verify that both identity values are present in either mode.
[[ -n $name && -n $email ]] ||
    fail "Both user.name and user.email are required: $owner"

# Write the values to the repository's local Git configuration.
# Update both settings from the mapping even if one is already set.
git config --local --replace-all -- user.name "$name" ||
    fail "Failed to set user.name"

git config --local --replace-all -- user.email "$email" ||
    fail "Failed to set user.email"

# Print the configured identity.
printf '[post-checkout] %s (%s)\n' "$owner" "$mode"
printf '  user.name  = %s\n' "$name"
printf '  user.email = %s\n' "$email"
